<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Whispree</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.17</string>
	<key>CFBundleVersion</key>
	<string>0.0.17</string>
	<!-- 메뉴바 우선 앱: `.accessory`로 시작하고, mainWindow/onboardingWindow가 보일 때만
	     AppDelegate가 `.regular`로 승격한다. false로 두고 런타임에 강등하면 매 실행마다
	     (LaunchAtLogin으로 조용히 뜨는 경우 포함) Dock 아이콘이 번쩍인다. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Whispree uses AppleEvents to remember the active Chrome tab/input element and iTerm2 session(pane) + tmux pane before recording, so the transcribed text can be pasted back into the same location.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Whispree needs microphone access to record your voice for transcription.</string>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://arsture.github.io/whispree/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>s44fNNpNBumMWbemL71UC323Ke9lgOL90FIqX/ArQFY=</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.whispree.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>whispree</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
